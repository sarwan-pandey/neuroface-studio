{
  "version": 2,
  "name": "neuroface-studio",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1",
      "headers": {
        "Permissions-Policy": "camera=*",
        "Access-Control-Allow-Origin": "*"
      }
    }
  ]
}
